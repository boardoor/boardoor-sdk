{
  "name": "boardoor-sdk",
  "private": true,
  "scripts": {
    "build": "pnpm -r --if-present run build:artifact",
    "test:run": "pnpm -r --if-present run test:run && pnpm creator:check",
    "creator:policy:test": "tsx scripts/check-creator-template-policy.test.ts",
    "creator:check": "pnpm creator:policy:test && tsx scripts/check-creator-template.ts",
    "lint": "oxlint packages/ scripts/",
    "format:check": "oxfmt --check packages/ scripts/",
    "sdk:api": "tsx scripts/check-sdk-api.ts",
    "sbom:check": "tsx scripts/check-sbom.ts",
    "artifact:check": "tsx scripts/check-artifacts.ts",
    "public-state:check": "tsx scripts/check-public-state.test.ts && tsx scripts/check-public-state.ts",
    "release:check": "pnpm build && pnpm sdk:api && pnpm sbom:check && tsx scripts/release.ts && pnpm artifact:check && pnpm public-state:check"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "npm": "12.0.2",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "typescript-api": "npm:typescript@5.9.3"
  },
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "packageManager": "pnpm@11.10.0"
}

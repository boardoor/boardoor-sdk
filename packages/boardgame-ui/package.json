{
  "name": "@boardoor/ui",
  "version": "0.1.0-alpha.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./playing-cards": "./src/playing-cards/index.ts",
    "./layout": "./src/layout/index.ts",
    "./genre": "./src/genre/index.ts",
    "./locales": "./src/locales/index.ts",
    "./audio": "./src/audio/index.ts",
    "./styles/ui.css": "./src/styles/ui.css"
  },
  "scripts": {
    "build": "tsc -b",
    "build:artifact": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && tsx ../../scripts/fix-sdk-esm-imports.ts dist && tsx scripts/build-css.ts",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "devDependencies": {
    "@boardoor/core": "workspace:*",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/oxide": "^4.3.3",
    "@types/react": "^19.2.17",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@boardoor/core": "0.1.0-alpha.0",
    "react": ">=18",
    "react-dom": ">=18",
    "react-i18next": ">=14"
  }
}

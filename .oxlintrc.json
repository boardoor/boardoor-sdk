{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "react-hooks", "jsx-a11y", "import", "unicorn"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "no-console": "off",
    "react/react-in-jsx-scope": "off",
    "react-hooks/exhaustive-deps": "error",
    "jsx-a11y/click-events-have-key-events": "off",
    "jsx-a11y/no-static-element-interactions": "off",
    "jsx-a11y/no-autofocus": "off",
    "jsx-a11y/iframe-has-title": "off",
    "unicorn/filename-case": "off",
    "unicorn/no-new-array": "off",
    "import/no-cycle": "off",
    "import/no-named-as-default": "off",
    "import/no-named-as-default-member": "off",
    "import/no-unassigned-import": "off"
  },
  "overrides": [
    {
      "files": ["packages/boardgame-core/src/**/*.ts", "packages/boardgame-core/src/**/*.tsx"],
      "rules": {
        "no-shadow": "off",
        "unicorn/consistent-function-scoping": "off",
        "no-instanceof-builtins": "off",
        "unicorn/prefer-add-event-listener": "off",
        "unicorn/no-array-sort": "off",
        "unicorn/no-array-reverse": "off"
      }
    },
    {
      "files": ["apps/**/*.test.ts", "apps/**/*.test.tsx", "apps/**/src/App.tsx"],
      "rules": {
        "unicorn/consistent-function-scoping": "off"
      }
    }
  ],
  "settings": {
    "react": {
      "formComponents": ["Form"],
      "linkComponents": [
        { "name": "Link", "linkAttribute": "to" },
        { "name": "NavLink", "linkAttribute": "to" }
      ],
      "version": "19",
      "componentWrapperFunctions": []
    }
  },
  "env": {
    "builtin": true
  },
  "globals": {},
  "ignorePatterns": [
    "build",
    "dist",
    "dist-games",
    "node_modules",
    ".react-router",
    "*.gen.ts",
    "packages/boardgame-core/src/client/debug/**",
    "worker-configuration.d.ts"
  ]
}
